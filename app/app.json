{
  "expo": {
    "name": "TrocaLivros",
    "slug": "mybooks",
    "scheme": "mybooks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mybooks.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mybooks.app"
    },
    "web": {
      "output": "single",
      "name": "TrocaLivros",
      "shortName": "TrocaLivros",
      "themeColor": "#B90041",
      "backgroundColor": "#FFF8F7",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o TrocaLivros use as fotos que você escolher para o perfil e os livros.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o TrocaLivros use a câmera para ler o ISBN dos livros.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
