EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001

# Clerk is enabled automatically when the publishable key is present.
EXPO_PUBLIC_AUTH_MODE=clerk
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google native sign-in (client IDs are public; configure the provider in Clerk first).
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_DEV_USER_ID=dev-mybooks-user
