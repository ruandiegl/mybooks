NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://mybooks:mybooks@localhost:5432/mybooks?schema=public
PUBLIC_API_BASE_URL=http://localhost:3001
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional PWA origin; merged into CLIENT_ORIGINS without changing the existing list.
PWA_CLIENT_ORIGIN=

# Native authentication is the only supported authority.
AUTH_MODE=native

# Self-hosted auth: use unique production secrets; never reuse these markers.
BCRYPT_ROUNDS=12
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_JWT_ISSUER=trocalivros-api
AUTH_JWT_AUDIENCE=trocalivros-client
AUTH_JWT_SECRET=replace-with-base64-encoded-32-byte-random-secret
AUTH_TOKEN_PEPPER=replace-with-base64-encoded-32-byte-random-secret
AUTH_CPF_HMAC_KEY=replace-with-base64-encoded-32-byte-random-secret
AUTH_CPF_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

ISBN_API_BASE_URL=https://brasilapi.com.br/api
ISBN_API_TIMEOUT_MS=6000
ISBN_RATE_LIMIT_WINDOW_MS=60000
ISBN_LOOKUP_LIMIT=30

STORAGE_MODE=development
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional: somente para leitura dos avatares legados; fotos de livros usam GET assinado.
R2_PUBLIC_URL=
R2_PRESIGN_EXPIRES_IN=300
R2_GET_URL_EXPIRES_IN=300

RESEND_API_KEY=
RESEND_FROM_EMAIL=TrocaLivros <onboarding@resend.dev>

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=60000
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_LIMIT=10
AUTH_VERIFY_LIMIT=10
AUTH_RESEND_LIMIT=3
AUTH_FORGOT_PASSWORD_LIMIT=3
AUTH_RESET_PASSWORD_LIMIT=5
AUTH_REFRESH_LIMIT=30
AUTH_PENDING_REGISTRATION_TTL_HOURS=24
