NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://mybooks:mybooks@localhost:5432/mybooks?schema=public
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006

# Clerk is enabled when AUTH_MODE=clerk and both Clerk keys are present.
AUTH_MODE=development
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

ISBN_API_BASE_URL=https://brasilapi.com.br/api
ISBN_API_TIMEOUT_MS=6000

STORAGE_MODE=development
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRESIGN_EXPIRES_IN=300

RESEND_API_KEY=
RESEND_FROM_EMAIL=MyBooks <onboarding@resend.dev>

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
