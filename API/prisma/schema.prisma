generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String               @id @default(uuid())
  clerkUserId                String?              @unique
  name                       String
  email                      String?              @unique
  passwordHash               String?
  legacyPassHash             String?              @map("passHash")
  emailVerifiedAt            DateTime?
  pendingRegistrationExpiresAt DateTime?
  firstName                  String?
  lastName                   String?
  cpfHash                    String?              @unique
  cpfEncrypted               String?
  phone                      String?
  interests                  String[]             @default([])
  profileCompletedAt         DateTime?
  booksOnboardingCompletedAt DateTime?
  premiumTrialStartedAt     DateTime?
  premiumTrialEndsAt        DateTime?
  premiumOfferPromptedAt    DateTime?
  premiumOfferCohort        PremiumOfferCohort @default(NEW)
  dailyLikeUsages           LikeDailyUsage[]
  isActive                   Boolean              @default(false)
  avatarUrl                  String?
  bio                        String?
  city                       String?
  books                      Book[]
  interactions               Interaction[]        @relation("InteractionActor")
  matchesAsUserA             Match[]              @relation("MatchUserA")
  matchesAsUserB             Match[]              @relation("MatchUserB")
  conversationMembers        ConversationMember[]
  messages                   Message[]
  authSessions               AuthSession[]
  authCodes                  AuthCode[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([pendingRegistrationExpiresAt])
}

model AuthSession {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String       @unique
  familyId         String
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?      @unique
  replacedBy       AuthSession? @relation("AuthSessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         AuthSession? @relation("AuthSessionReplacement")
  userAgent        String?
  ipHash           String?
  createdAt        DateTime     @default(now())
  lastUsedAt       DateTime     @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model AuthCode {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AuthCodeType
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int          @default(0)
  lastSentAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Book {
  id               String           @id @default(uuid())
  title            String
  subtitle         String?
  authors          String[]         @default([])
  publisher        String?
  synopsis         String?
  year             Int?
  pageCount        Int?
  subjects         String[]         @default([])
  isbn             String?
  isbnStatus       IsbnStatus       @default(NONE)
  isbnProvider     String?
  isbnValidatedAt  DateTime?
  coverExternalUrl String?
  availability     BookAvailability @default(AVAILABLE)
  ownerId          String?          @map("user_id")
  owner            User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images           BookImage[]
  interactions     Interaction[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([ownerId, createdAt])
  @@index([availability, createdAt])
  @@index([isbn])
  @@map("Book")
}

model BookImage {
  id         String   @id @default(uuid())
  url        String
  storageKey String?  @unique
  mimeType   String?
  size       Int?
  isCover    Boolean  @default(false)
  bookId     String   @map("book_id")
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("BookImage")
}

model LikeDailyUsage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetBookId String
  quotaDate    DateTime @db.Date
  createdAt    DateTime @default(now())

  @@unique([userId, targetBookId, quotaDate])
  @@index([userId, quotaDate])
}

model Interaction {
  id             String            @id @default(uuid())
  actorId        String
  actor          User              @relation("InteractionActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetBookId   String
  targetBook     Book              @relation(fields: [targetBookId], references: [id], onDelete: Cascade)
  action         InteractionAction
  clientActionId String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([actorId, targetBookId])
  @@index([targetBookId, action])
}

model Match {
  id           String        @id @default(uuid())
  userAId      String
  userA        User          @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId      String
  userB        User          @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status       MatchStatus   @default(ACTIVE)
  conversation Conversation?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
}

model Conversation {
  id        String               @id @default(uuid())
  matchId   String               @unique
  match     Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientMessageId String
  body            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
}

enum IsbnStatus {
  NONE
  VALID
}

enum PremiumOfferCohort {
  EXISTING
  NEW
}

enum BookAvailability {
  AVAILABLE
  RESERVED
  EXCHANGED
}

enum InteractionAction {
  LIKE
  PASS
}

enum MatchStatus {
  ACTIVE
  ARCHIVED
}

enum AuthCodeType {
  EMAIL_VERIFY
  PASSWORD_RESET
}
